{
  "name": "dsh-notify",
  "version": "0.3.1",
  "private": true,
  "description": "Desktop notifications for DeepSeek Harness: turn finished, agent asks a question, or a tool needs approval. Windows toasts are clickable and jump back to the session that raised them.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2 <0.3.0"
  },
  "license": "MIT"
}
